# RouteX (Revised Scope: Delivery Operations & Truck Profitability)
# Copy this file to `.env.local` and configure your Supabase project values.
# Never expose a Supabase service_role key in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required only by the guarded local/disposable-test seed command.
# Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only session signing key. Required in production environments when using signed cookie sessions.
# Generate a strong 64-character random string (e.g. `openssl rand -hex 32`).
ROUTEX_SESSION_SECRET=your-server-only-hmac-secret-min-32-chars

# Uncomment only for a disposable hosted test project. Localhost does not need it.
# ROUTEX_SEED_ENV=test

